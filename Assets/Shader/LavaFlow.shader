Shader "Custom/LavaFlow"
{
    // Lava surface driven by Flow Maps (Valve-style dual-phase sampling)
    // over a baked periodic 3D noise volume: R = Voronoi cell field
    // (bright interiors, dark seams), G = Voronoi cell-seam field
    // (bright seams). Textures are generated by LavaFlowMapBaker.cs
    // (Tools > Lava > Bake Flow Assets).
    //
    // Two behaviours, blended by the world normal:
    //   Top   — molten crust with glowing cracks; molten "fingers" creep
    //           outward along the top flow map and boil over time (晕开).
    //   Sides — vertically stretched veins flowing downward, fast bright
    //           drips descending from the top edge; a heat band sweeps up
    //           the wall and the lava cools as it falls.
    //
    // The noise is sampled in OBJECT space with a per-object hash offset
    // (Y kept 0 so the noise field stays continuous across the top edge),
    // so pattern density and the height gradients stay uniform regardless
    // of instance scale while each pool still looks different. Assumes
    // axis-aligned boxes (ProBuilder), positionOS in [-0.5, 0.5]^3.

    Properties
    {
        [Header(Colors)]
        [HDR] _CoreColor ("Core Color", Color) = (1, 0.55, 0.1, 1)
        [HDR] _HotColor ("Hot Color", Color) = (0.95, 0.25, 0.02, 1)
        [HDR] _CrustColor ("Crust Color", Color) = (0.07, 0.04, 0.03, 1)
        _EmissionStrength ("Emission Strength", Range(0, 3)) = 0

        [Header(Textures)]
        _LavaNoise ("Lava Noise (3D)", 3D) = "black" {}
        _FlowMapTop ("Flow Map (Top)", 2D) = "black" {}
        _FlowMapSide ("Flow Map (Side)", 2D) = "black" {}
        _FlowMapScale ("Flow Map Scale", Range(0.1, 4)) = 1

        [Header(Flow)]
        _FlowSpeed ("Flow Speed", Range(0, 3)) = 0.7
        _WarpAmount ("Warp Amount", Range(0, 4)) = 1

        [Header(Top)]
        _TopThreshold ("Top Threshold", Range(0, 1)) = 0.55
        _TopBlend ("Top Blend", Range(0, 0.5)) = 0.25
        _TopNoiseScale ("Top Noise Scale", Range(0.1, 5)) = 1.3
        _TopCoolRate ("Top Cool Rate", Range(0, 10)) = 5
        _PlateScale ("Plate Scale", Range(0.05, 3)) = 0.7
        _PoolScale ("Pool Scale", Range(0.1, 10)) = 2.2
        _CrackScale ("Crack Scale", Range(0.1, 20)) = 8
        _CrackThreshold ("Crack Threshold", Range(0, 1)) = 0.72
        _FingerAmount ("Finger Amount", Range(0, 3)) = 1
        _FingerScale ("Finger Scale", Range(0.05, 5)) = 1.2
        _FingerEvolve ("Finger Evolve", Range(0, 3)) = 1

        [Header(Sides)]
        _CoolRate ("Cool Rate", Range(0, 4)) = 1.5
        _StreakScale ("Streak Scale", Range(0.1, 8)) = 3.5
        _VeinWidth ("Vein Width", Range(0.01, 0.5)) = 0.08
        _DripSpeed ("Drip Speed", Range(0, 3)) = 0.6
        _DripThreshold ("Drip Threshold", Range(0, 1)) = 0.68
        _DripReach ("Drip Reach", Range(0, 1)) = 0.8
        _FrontTop ("Front Top", Range(0, 2)) = 1
        _FrontBottom ("Front Bottom", Range(0, 2)) = 0
        _FrontCycleSpeed ("Front Cycle Speed", Range(0, 0.2)) = 0.03
        _FrontSharpness ("Front Sharpness", Range(0, 12)) = 6
    }

    SubShader
    {
        Tags
        {
            "RenderPipeline" = "UniversalPipeline"
            "RenderType" = "Opaque"
            "Queue" = "Geometry"
        }

        // ── Forward (colour) pass ─────────────────────────────────────
        Pass
        {
            Name "Forward"
            Tags { "LightMode" = "UniversalForward" }

            Cull Back
            ZWrite On

            HLSLPROGRAM
            #pragma vertex vert
            #pragma fragment frag
            #pragma target 3.5
            #pragma multi_compile_fog
            #pragma multi_compile _ _MAIN_LIGHT_SHADOWS _MAIN_LIGHT_SHADOWS_CASCADE

            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl"

            TEXTURE3D(_LavaNoise);        SAMPLER(sampler_LavaNoise);
            TEXTURE2D(_FlowMapTop);       SAMPLER(sampler_FlowMapTop);
            TEXTURE2D(_FlowMapSide);      SAMPLER(sampler_FlowMapSide);

            // All three passes declare the identical UnityPerMaterial
            // layout — required for SRP Batcher compatibility.
            CBUFFER_START(UnityPerMaterial)
                float4 _CoreColor;
                float4 _HotColor;
                float4 _CrustColor;
                float  _EmissionStrength;
                float  _FlowMapScale;
                float  _FlowSpeed;
                float  _WarpAmount;
                float  _TopThreshold;
                float  _TopBlend;
                float  _TopNoiseScale;
                float  _TopCoolRate;
                float  _PlateScale;
                float  _PoolScale;
                float  _CrackScale;
                float  _CrackThreshold;
                float  _FingerAmount;
                float  _FingerScale;
                float  _FingerEvolve;
                float  _CoolRate;
                float  _StreakScale;
                float  _VeinWidth;
                float  _DripSpeed;
                float  _DripThreshold;
                float  _DripReach;
                float  _FrontTop;
                float  _FrontBottom;
                float  _FrontCycleSpeed;
                float  _FrontSharpness;
            CBUFFER_END

            struct Attributes
            {
                float4 positionOS : POSITION;
                float3 normalOS   : NORMAL;
            };

            struct Varyings
            {
                float4 positionHCS : SV_POSITION;
                float3 positionWS  : TEXCOORD0;
                float3 localPos    : TEXCOORD1;
                float3 normalWS    : TEXCOORD2;
                float4 shadowCoord : TEXCOORD3;
            };

            // Per-object hash: decorrelates the shared ProBuilder box so
            // each pool gets its own noise slice. (URP's Shadows.hlsl
            // already defines Hash — keep our own name.)
            float3 LavaHashOffset()
            {
                float3 origin = float3(unity_ObjectToWorld._m03,
                                       unity_ObjectToWorld._m13,
                                       unity_ObjectToWorld._m23);
                float3 cell = floor(origin);
                float hx = frac(sin(dot(cell, float3(12.9898, 78.233, 37.719))) *
                                43758.5453);
                float hz = frac(sin(dot(cell + 7.13, float3(39.346, 11.135, 91.731))) *
                                43758.5453);
                return float3(hx * 4.0 - 2.0, 0.0, hz * 4.0 - 2.0);
            }

            half3 LavaColor(float heat)
            {
                half3 c = _CrustColor.rgb;
                c = lerp(c, _CoreColor.rgb, smoothstep(0.08, 0.42, heat));
                c = lerp(c, _HotColor.rgb,  smoothstep(0.40, 0.72, heat));
                c = lerp(c, half3(2.0, 1.7, 1.35), smoothstep(0.66, 0.88, heat));
                return c;
            }

            // Dual-phase sample with two extra taps lagged along the flow
            // direction. The lagged taps smear the pattern into streaks
            // along the flow — without them a single frame shows isotropic
            // noise blobs and the motion reads as a sliding texture rather
            // than flowing lava. dirOff is the per-cycle displacement
            // (dir * Warp * scale), so the lags are in the same units.
            // Returns (Voronoi cell field, Voronoi border field) from the
            // R and G channels of the baked volume.
            float2 LavaSmearSample(float3 pos, float3 dirOff,
                                   float phase, float blend)
            {
                float3 offA = dirOff * phase;
                float3 offB = dirOff * frac(phase - 0.5);
                float4 a0 = SAMPLE_TEXTURE3D(_LavaNoise, sampler_LavaNoise, pos - offA);
                float4 a1 = SAMPLE_TEXTURE3D(_LavaNoise, sampler_LavaNoise, pos - offA - dirOff * 0.18);
                float4 a2 = SAMPLE_TEXTURE3D(_LavaNoise, sampler_LavaNoise, pos - offA - dirOff * 0.36);
                float4 b0 = SAMPLE_TEXTURE3D(_LavaNoise, sampler_LavaNoise, pos - offB);
                float4 b1 = SAMPLE_TEXTURE3D(_LavaNoise, sampler_LavaNoise, pos - offB - dirOff * 0.18);
                float4 b2 = SAMPLE_TEXTURE3D(_LavaNoise, sampler_LavaNoise, pos - offB - dirOff * 0.36);
                float r = lerp(a0.r * 0.5 + a1.r * 0.3 + a2.r * 0.2,
                               b0.r * 0.5 + b1.r * 0.3 + b2.r * 0.2, blend);
                float g = lerp(a0.g * 0.5 + a1.g * 0.3 + a2.g * 0.2,
                               b0.g * 0.5 + b1.g * 0.3 + b2.g * 0.2, blend);
                return float2(r, g);
            }

            Varyings vert(Attributes IN)
            {
                Varyings OUT;
                VertexPositionInputs vpi = GetVertexPositionInputs(IN.positionOS.xyz);
                OUT.positionHCS = vpi.positionCS;
                OUT.positionWS  = vpi.positionWS;
                OUT.localPos    = IN.positionOS.xyz;
                OUT.normalWS    = TransformObjectToWorldNormal(IN.normalOS);
                OUT.shadowCoord = GetShadowCoord(vpi);
                return OUT;
            }

            half4 frag(Varyings IN) : SV_Target
            {
                half3 n = normalize(IN.normalWS);
                // Local height: 0 (bottom) → 1 (top); the box is ±0.5.
                half v = saturate(IN.localPos.y + 0.5);

                // ── Top / side split by world normal (no UVs needed) ──
                half topMask = smoothstep(_TopThreshold - _TopBlend,
                                          _TopThreshold, n.y);

                // Along-wall coordinate via dominant horizontal axis:
                // ±X faces use z, ±Z faces use x. No tangent, no
                // degenerate normalize.
                half sideU = (abs(n.x) > 0.5) ? IN.localPos.z : IN.localPos.x;
                half3 wallX = (abs(n.x) > 0.5) ? half3(0, 0, 1) : half3(1, 0, 0);

                // ── Flow directions from the baked flow maps ──────────
                // (sRGB-off, linear data: rg * 2 - 1 recovers the vector)
                half2 flowTop = SAMPLE_TEXTURE2D(
                    _FlowMapTop, sampler_FlowMapTop,
                    IN.localPos.xz * _FlowMapScale).rg * 2.0 - 1.0;
                half3 dirTop = half3(flowTop.x, 0.0, flowTop.y);

                half2 flowSide = SAMPLE_TEXTURE2D(
                    _FlowMapSide, sampler_FlowMapSide,
                    half2(sideU, v) * _FlowMapScale).rg * 2.0 - 1.0;
                half3 dirSide = wallX * flowSide.x + half3(0, 1, 0) * flowSide.y;

                // ── Dual-phase sampling (seamless loop) ───────────────
                // Sampling at pos − dir·phase makes the pattern appear to
                // move along +dir; the two copies are 0.5 apart so the
                // loop always fades onto the unsheared pattern.
                //
                // All time-driven math stays in float: half precision
                // quantises frac(_Time.y * speed) within minutes of
                // editor uptime and the flow visibly freezes.
                float phase = frac(_Time.y * _FlowSpeed);
                float blend = abs(phase - 0.5) * 2.0;

                float3 basePos = IN.localPos + LavaHashOffset();

                // ── Top: glowing cracks dragged by the flow map. The
                //    G channel is the Voronoi cell-seam field, so the
                //    cracks form one connected network, not specks. ────
                float3 crackScale = _CrackScale * float3(1, 1, 1);
                float3 crackPos = basePos * crackScale;
                float3 crackOff = dirTop * (_WarpAmount * crackScale);
                float crack = LavaSmearSample(crackPos, crackOff,
                                              phase, blend).g;

                // ── Top: molten fingers (晕开). Same drag at a slower
                //    phase and a stronger pull → stretched tendrils; the
                //    third noise axis doubles as time → boiling. ──────
                float fingerPhase = frac(_Time.y * _FlowSpeed * 0.6);
                float fingerBlend = abs(fingerPhase - 0.5) * 2.0;
                float3 fingerPos = basePos * _FingerScale;
                fingerPos.z += _Time.y * _FingerEvolve * 0.05;
                float3 fingerOff = dirTop * (_WarpAmount * 1.4 * _FingerScale);
                float finger = LavaSmearSample(fingerPos, fingerOff,
                                               fingerPhase, fingerBlend).r;

                // ── Top: cooling slabs (low frequency crust) ──────────
                float plate = SAMPLE_TEXTURE3D(_LavaNoise, sampler_LavaNoise,
                    basePos * (_PlateScale * _TopNoiseScale) +
                    float3(0.0, _Time.y * 0.02, 0.0)).r;

                // ── Top: large connected molten pool. Low frequency and
                //    a slow phase make the bulk of the lava read as one
                //    flowing mass (晕开), not scattered specks. ────────
                float poolPhase = frac(_Time.y * _FlowSpeed * 0.5);
                float poolBlend = abs(poolPhase - 0.5) * 2.0;
                float3 poolScale = _PoolScale * float3(1, 1, 1);
                float3 poolPos = basePos * poolScale;
                float3 poolOff = dirTop * (_WarpAmount * 0.8 * poolScale);
                float pool = LavaSmearSample(poolPos, poolOff,
                                             poolPhase, poolBlend).r;

                // ── Sides: vertically stretched veins. The Y stretch is
                //    chosen so StreakScale·Stretch·WarpAmount stays an
                //    integer → the vertical flow loops without a jump.
                // ──────────────────────────────────────────────────────
                float streakStretch = 2.0 / max(_StreakScale * _WarpAmount, 0.01);
                float3 streakScale = _StreakScale * float3(1, streakStretch, 1);
                float3 streakPos = basePos * streakScale;
                float3 streakOff = dirSide * (_WarpAmount * streakScale);
                float streak = LavaSmearSample(streakPos, streakOff,
                                               phase, blend).r;

                // ── Sides: fast bright drips descending from the top
                //    edge. Each vein has its own phase (staggered) and
                //    fades out right before its reset. ────────────────
                float3 dripPos = float3(sideU, v, 0.7) * float3(
                    _StreakScale * 0.5, _DripReach * 2.0 + 0.5, 1.0);
                dripPos.x += 9.13;               // decorrelate from streaks
                float dripN = SAMPLE_TEXTURE3D(_LavaNoise, sampler_LavaNoise,
                                               dripPos).r;
                float dripMask = step(_DripThreshold, dripN);
                float dripPhase = frac(_Time.y * _DripSpeed + dripN * 3.7);
                float dripHead = 1.0 - dripPhase * _DripReach;
                float dripFade = 1.0 - smoothstep(0.85, 1.0, dripPhase);
                float dripTip = 1.0 - smoothstep(0.0, 0.08, abs(v - dripHead));
                float dripTrail = step(dripHead, v) *
                    (1.0 - smoothstep(dripHead, dripHead + 0.25, v));
                float dripHeat = dripMask * dripFade *
                    max(dripTip, dripTrail * 0.5);

                // ── Heat assembly ──────────────────────────────────────
                // Top: one big connected molten pool (slow viscous bulk)
                // with crack veins and creeping fingers as accents on
                // top of it. The pool threshold sits near the noise
                // mid-level so the glowing region reads as one flowing
                // mass instead of scattered specks.
                float poolHeat = smoothstep(0.46, 0.60, pool);
                float crackHeat = smoothstep(_CrackThreshold - 0.12,
                                             _CrackThreshold + 0.06, crack);
                float fingerHeat = saturate((finger - 0.6) * 4.0) *
                                   _FingerAmount;
                float topCool = smoothstep(0.30, 0.30 + 0.15 * _TopCoolRate,
                                           plate);
                float topHeat = saturate(poolHeat + crackHeat * 0.45 +
                                         fingerHeat * 0.6);
                topHeat *= (1.0 - topCool * 0.65);

                // Sides: connected vein streams + drips, lit by a heat
                // band that sweeps up the wall; lava cools as it falls.
                // The threshold window is centred low enough that the
                // veins merge into continuous streams instead of fine
                // scratches.
                float vein = smoothstep(0.60 - _VeinWidth * 1.5,
                                        0.60 + _VeinWidth * 1.5, streak);
                float frontCycle = frac(_Time.y * _FrontCycleSpeed);
                float frontBand = saturate(1.0 - abs((float)v - frontCycle) *
                                           _FrontSharpness);
                float frontHeat = max(frontBand *
                                      lerp(_FrontBottom, _FrontTop, v), 0.4);
                float cool = smoothstep(0.0, _CoolRate, 1.0 - v);
                float sideHeat = max(vein, dripHeat) * frontHeat * (1.0 - cool);

                float heat = lerp(sideHeat, topHeat, topMask);

                // ── Colour: crust → core → hot → white-hot ───────────
                half3 glow = LavaColor(heat);

                // ── Lighting: main light on the crust, HDR emission on
                //    the molten parts. The 0.8 base keeps the surface
                //    alive at _EmissionStrength = 0; values > 1 feed
                //    URP Bloom. ─────────────────────────────────────────
                half3 albedo = lerp(_CrustColor.rgb, _CoreColor.rgb,
                                    saturate(heat * 0.6));
                half3 viewDir = GetWorldSpaceNormalizeViewDir(IN.positionWS);
                Light light = GetMainLight(IN.shadowCoord);
                half ndl = saturate(dot(n, light.direction));
                half atten = light.shadowAttenuation * light.distanceAttenuation;
                half3 ambient = SampleSH(n) * albedo;
                half3 diffuse = albedo * light.color * (ndl * atten);
                half3 lightHalfDir = normalize(light.direction + viewDir);
                half spec = pow(saturate(dot(n, lightHalfDir)), 24.0) *
                            0.12 * (1.0 - heat) * atten;
                half3 emission = glow * (1.1 + _EmissionStrength * 4.0);

                half3 color = ambient + diffuse + light.color * spec + emission;
                color = MixFog(color, ComputeFogFactor(IN.positionHCS.z));
                return half4(color, 1.0);
            }
            ENDHLSL
        }

        // ── Shadow caster pass ────────────────────────────────────────
        Pass
        {
            Name "ShadowCaster"
            Tags { "LightMode" = "ShadowCaster" }

            ZWrite On
            ZTest LEqual
            ColorMask 0

            HLSLPROGRAM
            #pragma vertex ShadowVert
            #pragma fragment ShadowFrag
            #pragma target 3.5

            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Shadows.hlsl"

            // Identical layout in every pass (SRP Batcher requirement).
            CBUFFER_START(UnityPerMaterial)
                float4 _CoreColor;
                float4 _HotColor;
                float4 _CrustColor;
                float  _EmissionStrength;
                float  _FlowMapScale;
                float  _FlowSpeed;
                float  _WarpAmount;
                float  _TopThreshold;
                float  _TopBlend;
                float  _TopNoiseScale;
                float  _TopCoolRate;
                float  _PlateScale;
                float  _PoolScale;
                float  _CrackScale;
                float  _CrackThreshold;
                float  _FingerAmount;
                float  _FingerScale;
                float  _FingerEvolve;
                float  _CoolRate;
                float  _StreakScale;
                float  _VeinWidth;
                float  _DripSpeed;
                float  _DripThreshold;
                float  _DripReach;
                float  _FrontTop;
                float  _FrontBottom;
                float  _FrontCycleSpeed;
                float  _FrontSharpness;
            CBUFFER_END

            float3 _LightDirection;
            float3 _LightPosition;

            struct Attributes
            {
                float4 positionOS : POSITION;
                float3 normalOS   : NORMAL;
            };

            struct Varyings
            {
                float4 positionHCS : SV_POSITION;
            };

            Varyings ShadowVert(Attributes IN)
            {
                Varyings OUT;
                float3 positionWS = TransformObjectToWorld(IN.positionOS.xyz);
                float3 normalWS = TransformObjectToWorldNormal(IN.normalOS);
                float4 positionCS = TransformWorldToHClip(
                    ApplyShadowBias(positionWS, normalWS, _LightDirection));
            #if UNITY_REVERSED_Z
                positionCS.z = min(positionCS.z, UNITY_NEAR_CLIP_VALUE);
            #else
                positionCS.z = max(positionCS.z, UNITY_NEAR_CLIP_VALUE);
            #endif
                OUT.positionHCS = positionCS;
                return OUT;
            }

            half4 ShadowFrag(Varyings IN) : SV_Target
            {
                return 0;
            }
            ENDHLSL
        }

        // ── Depth-only pass (for _CameraDepthTexture) ─────────────────
        Pass
        {
            Name "DepthOnly"
            Tags { "LightMode" = "DepthOnly" }

            ZWrite On
            ColorMask 0

            HLSLPROGRAM
            #pragma vertex DepthVert
            #pragma fragment DepthFrag
            #pragma target 3.5

            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

            // Identical layout in every pass (SRP Batcher requirement).
            CBUFFER_START(UnityPerMaterial)
                float4 _CoreColor;
                float4 _HotColor;
                float4 _CrustColor;
                float  _EmissionStrength;
                float  _FlowMapScale;
                float  _FlowSpeed;
                float  _WarpAmount;
                float  _TopThreshold;
                float  _TopBlend;
                float  _TopNoiseScale;
                float  _TopCoolRate;
                float  _PlateScale;
                float  _PoolScale;
                float  _CrackScale;
                float  _CrackThreshold;
                float  _FingerAmount;
                float  _FingerScale;
                float  _FingerEvolve;
                float  _CoolRate;
                float  _StreakScale;
                float  _VeinWidth;
                float  _DripSpeed;
                float  _DripThreshold;
                float  _DripReach;
                float  _FrontTop;
                float  _FrontBottom;
                float  _FrontCycleSpeed;
                float  _FrontSharpness;
            CBUFFER_END

            struct Attributes
            {
                float4 positionOS : POSITION;
            };

            struct Varyings
            {
                float4 positionHCS : SV_POSITION;
            };

            Varyings DepthVert(Attributes IN)
            {
                Varyings OUT;
                float3 positionWS = TransformObjectToWorld(IN.positionOS.xyz);
                OUT.positionHCS = TransformWorldToHClip(positionWS);
                return OUT;
            }

            half4 DepthFrag(Varyings IN) : SV_Target
            {
                return 0;
            }
            ENDHLSL
        }
    }

    FallBack "Hidden/Universal Render Pipeline/FallbackError"
}
